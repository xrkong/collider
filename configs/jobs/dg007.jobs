#!/bin/bash
#rj queue=curtin_ciraee features=a100 priority=550 runtime=24 mem=64g logdir=logs name=dg007_200

set -euo pipefail
echo "Running on $(hostname), TMPDIR=$TMPDIR"

source /data/curtin_ciraee/curtin_xiangrui/ENTER/etc/profile.d/conda.sh
conda activate /data/curtin_ciraee/curtin_xiangrui/env/conda/collider

nvidia-smi
python -c "import torch; print(torch.cuda.is_available(), torch.cuda.get_device_name(0))"

cd /data/curtin_ciraee/curtin_xiangrui/xrkong/collider
python train.py --experiment configs/experiments/dg007.yaml --skip-git-check

echo "Done."